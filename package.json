{
  "name": "drift-guard",
  "version": "1.0.0",
  "description": "Zero-config API contract drift detection proxy",
  "type": "module",
  "packageManager": "bun@1.3.4",
  "bin": {
    "driftguard": "./dist/cli.js",
    "drift-guard": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "preferGlobal": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "cli": "bun src/cli.ts",
    "dev": "bun src/proxy.ts",
    "start": "bun src/proxy.ts",
    "test": "bunx vitest run",
    "test:mvp": "bunx vitest run tests/mvp-loop.integration.test.ts",
    "test:battle": "bun scripts/battle-test.ts",
    "test:watch": "bunx vitest",
    "typecheck": "tsc --noEmit",
    "contract:report": "bun scripts/driftguard-ci.ts",
    "prepack": "bun run clean && bun run build"
  },
  "keywords": [
    "api",
    "contract-testing",
    "proxy",
    "schema",
    "drift-detection"
  ],
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.19.12",
    "hono": "^4.12.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
